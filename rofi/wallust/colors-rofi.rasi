normal-background: #140703;
normal-foreground: #F8F3F6;
urgent-background: #E4D9E4;
urgent-foreground: #F8F3F6;

alternate-active-background: #D8A9AA;
alternate-active-foreground: #F8F3F6;
alternate-normal-background: #140703;
alternate-normal-foreground: #F8F3F6;
alternate-urgent-background: #140703;
